# Point this at your running FastAPI backend.
# On Android emulator, 'localhost' won't reach your dev machine — use your
# machine's LAN IP (e.g. http://192.168.1.10:8000) or 10.0.2.2 for the
# standard Android emulator loopback.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000

# Default live-camera frame sampling rate (frames per second sent over the
# WebSocket for detection). Kept low on purpose — sending every camera
# frame wastes bandwidth and can queue up faster than the backend keeps
# up with. The Live Performance screen also lets the user override this
# per-session.
EXPO_PUBLIC_LIVE_SAMPLE_FPS=2
