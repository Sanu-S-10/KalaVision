{
  "expo": {
    "name": "KalaVision AI",
    "slug": "kalavision-ai",
    "scheme": "kalavision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1A0F0A"
    },
    "assetBundlePatterns": ["**/*"],
    "platforms": ["android", "ios", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kalavision.ai"
    },
    "android": {
      "package": "com.kalavision.ai",
      "permissions": ["CAMERA", "RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#1A0F0A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "KalaVision AI needs camera access to detect Kathakali mudras live."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
