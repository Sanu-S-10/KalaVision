{
  "name": "kalavision-ai",
  "version": "2.0.0",
  "description": "KalaVision AI — Kathakali Mudra & Expression Recognition Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --app-dir backend --reload-dir backend",
    "dev:frontend": "npm --prefix frontend run web",
    "dev:android": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm --prefix frontend run android\"",
    "backend": "npm run dev:backend",
    "frontend": "npm run dev:frontend",
    "start": "npm run dev",
    "test:backend": "python -m pytest -v backend/tests -o pythonpath=backend",
    "typecheck:frontend": "npm --prefix frontend run typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
