# --- App Configuration ---
APP_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://127.0.0.1:8081

# --- AI Configuration ---
# DEMO_MODE: When true, prediction endpoints and WebSocket use mock detectors.
# Defaults to false so the real KalaVision Mudra Classifier is active by default.
DEMO_MODE=false

# Per-model mode: auto | mock | real
# Real mudra classifier uses backend/models/mudra/ package with MediaPipe landmarks.
MUDRA_MODEL_MODE=real

# Real mudra model package path (relative paths resolve against backend/)
MUDRA_MODEL_DIR=models/mudra
MUDRA_MODEL_VERSION=1.0

# Detection confidence, smoothing, and sampling
CONFIDENCE_THRESHOLD=0.55
SMOOTHING_WINDOW_SIZE=5
DEFAULT_SAMPLE_FPS=2.0
LIVE_SAMPLE_FPS=2.0

# Optional HTTP model service endpoints
MUDRA_MODEL_API_URL=
MODEL_API_TIMEOUT_SECONDS=10.0

# File upload limits
MAX_UPLOAD_SIZE_MB=200
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.webm
